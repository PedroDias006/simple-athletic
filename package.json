  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.3"
  }
