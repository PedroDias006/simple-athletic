# Copie este arquivo para bots/marketing/.env e preencha só o que for usar.
# O .env fica só no seu computador (está no .gitignore). No GitHub, use Secrets.

# Endereço do site, sem barra no final
SITE_URL=https://seudominio.com.br

# Telegram (veja o README: @BotFather + canal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X / Twitter (4 chaves do app no developer.x.com)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Instagram (conta Business/Creator ligada a uma Página do Facebook)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# WhatsApp Cloud API — desligado até você trocar para true
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Números com DDI e DDD, separados por vírgula. Só quem pediu para receber!
WHATSAPP_TO=5511999999999
WHATSAPP_TEMPLATE=oferta_do_dia

# Ajustes opcionais (valores padrão entre parênteses)
# HORA_INICIO=8            (8)
# HORA_FIM=22              (22)
# INTERVALO_MINUTOS=55     (55)
# MAX_POSTS_DIA=8          (8)  — vale para Telegram e X
# INSTAGRAM_MAX_POR_DIA=3  (3)
# WHATSAPP_MAX_POR_DIA=1   (1)
# DESCONTO_MINIMO=10       (10)
# REPOSTAR_APOS_DIAS=7     (7)
